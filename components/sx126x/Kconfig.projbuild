menu "SX1262 Radio"

	config SX126X_GPIO_RANGE_MAX
		int
		default 33 if IDF_TARGET_ESP32
		default 46 if IDF_TARGET_ESP32S2
		default 48 if IDF_TARGET_ESP32S3
		default 21 if IDF_TARGET_ESP32C3
		default 30 if IDF_TARGET_ESP32C6
		default 48

	comment "Defaults match the Repeater PCB: Ai-Thinker Ra-01SH on an ESP32-C3-MINI-1U"

	config SX126X_MOSI_GPIO
		int "MOSI GPIO"
		range 0 SX126X_GPIO_RANGE_MAX
		default 7
		help
			Repeater PCB: IO7 (FSPID/MOSI) -> Ra-01SH pin 14.

	config SX126X_MISO_GPIO
		int "MISO GPIO"
		range 0 SX126X_GPIO_RANGE_MAX
		default 2
		help
			Repeater PCB: IO2 (FSPIQ/MISO) <- Ra-01SH pin 13. IO2 is a boot
			strapping pin that must read high at reset; R4 (10k to 3V3) holds it
			there while the radio's MISO is high-impedance.

	config SX126X_SCK_GPIO
		int "SCK GPIO"
		range 0 SX126X_GPIO_RANGE_MAX
		default 6
		help
			Repeater PCB: IO6 (FSPICLK) -> Ra-01SH pin 12.

	config SX126X_NSS_GPIO
		int "NSS (chip select) GPIO"
		range 0 SX126X_GPIO_RANGE_MAX
		default 10
		help
			Repeater PCB: IO10 (FSPICS0) -> Ra-01SH pin 15.

	config SX126X_RST_GPIO
		int "RST GPIO"
		range 0 SX126X_GPIO_RANGE_MAX
		default 21
		help
			Repeater PCB: IO21 (U0TXD) -> JP6 -> Ra-01SH pin 4. This is UART0's TX
			pin, so the console must not be on UART0 (sdkconfig.defaults moves it
			to USB-Serial-JTAG). The ROM bootloader still prints on it before the
			app starts, which just pulses the radio's reset - harmless, since
			init hard-resets the radio anyway.

	config SX126X_BUSY_GPIO
		int "BUSY GPIO"
		range 0 SX126X_GPIO_RANGE_MAX
		default 1
		help
			Repeater PCB: IO1 <- Ra-01SH pin 10. The SX126x holds this high while
			it is processing a command; the driver waits on it before every SPI
			transaction. If it never drops, the module is miswired or unpowered.

	config SX126X_DIO1_GPIO
		int "DIO1 (interrupt) GPIO"
		range 0 SX126X_GPIO_RANGE_MAX
		default 20
		help
			Repeater PCB: IO20 (U0RXD) <- JP5 <- Ra-01SH pin 6. Carries
			TxDone/RxDone/CrcErr/Timeout. UART0's RX pin, so as with RST the
			console must live on USB-Serial-JTAG.

	choice SX126X_SPI_HOST
		prompt "SPI peripheral"
		default SX126X_SPI2_HOST
		config SX126X_SPI2_HOST
			bool "SPI2_HOST"
		config SX126X_SPI3_HOST
			depends on IDF_TARGET_ESP32 || IDF_TARGET_ESP32S2 || IDF_TARGET_ESP32S3
			bool "SPI3_HOST"
	endchoice

endmenu
