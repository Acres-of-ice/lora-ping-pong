# Shared defaults for both roles. Only read when an sdkconfig is first created -
# see the README before editing.
CONFIG_IDF_TARGET="esp32c3"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The Repeater PCB routes UART0 (GPIO20/21) to the radio's DIO1 and RESET via
# JP5/JP6, so the console must not use UART0. Logs and flashing go over the
# ESP32-C3's built-in USB (GPIO18/19).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The max-drain test wants the worst case: full clock, -O2, 1 kHz tick.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# The serial console fetches routes from the board's own web server over loopback
# (main/console.c). httpd writes every header field separately, and on loopback
# those arrive as a burst of tiny segments faster than the console task reads
# them; past 6 the socket's mailbox refuses them and lwIP retries only on its
# 250 ms timer, so every request took a quarter of a second, and a long one
# seconds. Pointers only: 32 costs about 100 bytes per open socket.
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
